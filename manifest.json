{
  "manifest_version": 3,
  "name": "Chrome Password Lock",
  "version": "2.2",
  "description": "Lock Chrome with a password on startup and after idle time",
  "permissions": ["storage", "tabs", "alarms", "idle"],
  "background": { "service_worker": "background.js" },
  "options_page": "options.html",
  "action": { "default_title": "Lock Chrome" },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["activity.js"],
      "run_at": "document_idle",
      "all_frames": false
    }
  ],
  "commands": {
    "lock-now": {
      "suggested_key": { "default": "Ctrl+Shift+L" },
      "description": "Lock Chrome"
    }
  }
}
